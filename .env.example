# ===============================================
# AgentSOC — Configuration Environment Variables
# ===============================================

# Server & Network
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agentsoc

# Redis Stream
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_STREAM_KEY=events:stream

# Ollama LLM Configuration (Cached fallback active if offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Authentication & Security
# Note: Master Admin Password is fixed/locked to: 24282428
JWT_SECRET=agentsoc-cyber-sec-super-secret-key-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400

# Threat Intelligence
THREAT_INTEL_CACHE_TTL=3600

